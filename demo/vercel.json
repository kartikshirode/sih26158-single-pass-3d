{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(assets|gallery/assets|gallery/mesh)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  }
}
